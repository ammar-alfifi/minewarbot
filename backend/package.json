{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:sqlite": "STORAGE=sqlite node src/server.js",
    "backup": "node scripts/backup.mjs export",
    "restore": "node scripts/backup.mjs import",
    "webhook": "node scripts/set-webhook.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "telegraf": "^4.16.3"
  }
}
