# ============================================================================
# إعدادات الباكند — انسخ هذا الملف إلى .env ثم ضع التوكن الحقيقي
# .env مستثنى من git ولا يجب رفعه أو مشاركته أبداً
# ============================================================================

# ---- البوت ----
# من @BotFather → /mybots → اختر البوت → API Token
BOT_TOKEN=ضع_التوكن_هنا_من_BotFather
BOT_USERNAME=MineWarrBot

# ---- السيرفر ----
PORT=3001
NODE_ENV=development
# رابط الواجهة (للتطوير المحلي أو نطاق النشر)
FRONTEND_URL=http://localhost:5173
# نطاقات مسموحة لـ CORS (افصل بينها بفواصل). اتركه فارغاً لاستخدام FRONTEND_URL
ALLOWED_ORIGINS=http://localhost:5173

# ---- المصادقة واللعب ----
# وضع الضيوف للتطوير المحلي فقط (false تلقائياً عند NODE_ENV=production)
ALLOW_GUEST=true
# صلاحية initData بالثواني (افتراضي 86400 = 24 ساعة)
INIT_DATA_MAX_AGE_SEC=86400
# سرّ توقيع توكنات الجلسة — اتركه فارغاً ليُشتق تلقائياً، وضعه في الإنتاج لثبات الجلسات
SESSION_SECRET=

# ---- التخزين وخدمة الواجهة ----
DATA_FILE=./data/players.json
# خدمة ملفات frontend/dist من نفس السيرفر (مفيد للنشر بخدمة واحدة)
SERVE_FRONTEND=true
# تفعيله خلف منصات النشر (Render/Railway) لقراءة IP الحقيقي
TRUST_PROXY=true
