{
  "$schema": "https://opencode.ai/config.json",
  // إعداد OpenCode مشترك بين أعضاء الفريق (يُودَع في الريبو فيعمل المساعد بنفس القواعد).
  // القيمة الأساسية هنا: منع قراءة أو تعديل ملفات الأسرار محلياً.
  // بقية الصلاحيات تبقى على الافتراضي حتى لا تتعطّل قاعدة النشر التلقائي في AGENTS.md.
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" }
  ]
}
