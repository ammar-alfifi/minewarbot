{
  "name": "telegram-miniapp-team",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend && npm run test:render --prefix frontend",
    "build": "npm run build --prefix frontend",
    "backup": "npm run backup --prefix backend",
    "webhook": "npm run webhook --prefix backend --",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:dry": "wrangler deploy --dry-run",
    "cf:tail": "wrangler tail",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f minewarr"
  },
  "devDependencies": {
    "wrangler": "^4.140.0"
  }
}
