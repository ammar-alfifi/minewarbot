{
  "name": "telegram-miniapp-team",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend && npm run test:render --prefix frontend",
    "build": "npm run build --prefix frontend",
    "backup": "npm run backup --prefix backend",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f minewarr"
  }
}
